{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pushly.app/contracts/user-profile.schema.json",
  "title": "UserProfile",
  "description": "rpc get_user_profile(user_id?, username?) — another player's profile (doc 15 §1, migration 0023; clan + rich stats 0036, D-080); null when not found or blocked. Example: fixtures/user_profile.json.",
  "type": [
    "object",
    "null"
  ],
  "required": [
    "user",
    "relation",
    "visible",
    "league",
    "stats",
    "headToHead"
  ],
  "additionalProperties": false,
  "properties": {
    "user": {
      "$ref": "user-card.schema.json"
    },
    "relation": {
      "enum": [
        "self",
        "friends",
        "outgoing",
        "incoming",
        "none"
      ]
    },
    "visible": {
      "type": "boolean"
    },
    "league": {
      "type": "object",
      "required": [
        "league",
        "tier"
      ],
      "properties": {
        "league": {
          "type": "string"
        },
        "tier": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "stats": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "repsTotal",
        "bestSet",
        "bestStreak",
        "achievements",
        "bestTrophies",
        "memberSince"
      ],
      "additionalProperties": false,
      "properties": {
        "repsTotal": {
          "type": "integer"
        },
        "bestSet": {
          "type": "integer"
        },
        "bestStreak": {
          "type": "integer"
        },
        "achievements": {
          "type": "integer"
        },
        "bestTrophies": {
          "type": "integer"
        },
        "memberSince": {
          "type": "string"
        },
        "achievementsTotal": {
          "type": "integer"
        },
        "level": {
          "type": "integer"
        },
        "xp": {
          "type": "integer"
        },
        "rank": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Global rank by trophies; null at 0 trophies."
        },
        "wakeStreak": {
          "type": "integer",
          "description": "Current wake streak."
        },
        "repsWeek": {
          "type": "integer",
          "description": "Push-ups in the last 7 local days."
        },
        "last7": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "integer"
          },
          "description": "Push-ups per local day, oldest first, today last."
        },
        "battles": {
          "type": "object",
          "required": [
            "wins",
            "losses",
            "draws",
            "winStreak",
            "bestWinStreak",
            "form"
          ],
          "properties": {
            "wins": {
              "type": "integer"
            },
            "losses": {
              "type": "integer"
            },
            "draws": {
              "type": "integer"
            },
            "winStreak": {
              "type": "integer"
            },
            "bestWinStreak": {
              "type": "integer"
            },
            "form": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "enum": [
                  "W",
                  "L",
                  "D"
                ]
              },
              "description": "Last 10 battles vs people, newest first."
            }
          }
        }
      }
    },
    "headToHead": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "wins",
        "losses",
        "draws"
      ],
      "properties": {
        "wins": {
          "type": "integer"
        },
        "losses": {
          "type": "integer"
        },
        "draws": {
          "type": "integer"
        }
      }
    },
    "clan": {
      "type": [
        "object",
        "null"
      ],
      "description": "The player's clan (clan-summary fields + role), null when not in a clan. Clans are public.",
      "required": [
        "id",
        "name",
        "tag",
        "rating",
        "memberCount",
        "role"
      ]
    }
  }
}
