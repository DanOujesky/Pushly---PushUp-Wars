{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pushly.app/contracts/clan-summary.schema.json",
  "title": "ClanSummary",
  "description": "A clan in lists (search_clans, war opponent, leaderboard). doc 09 §1.",
  "type": "object",
  "required": [
    "id",
    "name",
    "tag",
    "badge",
    "description",
    "joinPolicy",
    "minTrophies",
    "country",
    "warEnabled",
    "rating",
    "memberCount",
    "maxMembers",
    "myRole",
    "requested"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "tag": {
      "type": "string",
      "pattern": "^[A-Z0-9]{3,5}$"
    },
    "badge": {
      "type": "object",
      "additionalProperties": false,
      "description": "Clan badge (D-074): shape + color + emblem from shared/cosmetics/cosmetics.json; {} = default look from the tag.",
      "properties": {
        "shape": {
          "enum": [
            "shield",
            "round",
            "hex"
          ]
        },
        "color": {
          "enum": [
            "flame",
            "volt",
            "cyan",
            "lime",
            "gold",
            "red",
            "diamond",
            "pink"
          ]
        },
        "emblem": {
          "enum": [
            "flame",
            "fist",
            "bolt",
            "muscle",
            "wolf",
            "lion",
            "eagle",
            "skull",
            "dragon",
            "crown",
            "diamond",
            "rocket",
            "trident",
            "shark",
            "comet",
            "volcano"
          ]
        }
      }
    },
    "description": {
      "type": "string"
    },
    "joinPolicy": {
      "enum": [
        "open",
        "request",
        "invite_only"
      ]
    },
    "minTrophies": {
      "type": "integer"
    },
    "country": {
      "type": [
        "string",
        "null"
      ]
    },
    "warEnabled": {
      "type": "boolean"
    },
    "rating": {
      "type": "integer"
    },
    "memberCount": {
      "type": "integer"
    },
    "maxMembers": {
      "const": 30
    },
    "myRole": {
      "enum": [
        "leader",
        "co_leader",
        "elder",
        "member",
        null
      ]
    },
    "requested": {
      "type": "boolean"
    }
  }
}
