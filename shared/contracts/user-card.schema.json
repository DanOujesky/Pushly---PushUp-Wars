{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pushly.app/contracts/user-card.schema.json",
  "title": "UserCard",
  "description": "Another user as shown in friend lists, search, feed and leaderboards (app.user_card).",
  "type": "object",
  "required": [
    "id",
    "username",
    "avatarPreset",
    "country",
    "level",
    "trophies",
    "streak"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "username": {
      "type": "string"
    },
    "avatarPreset": {
      "type": [
        "string",
        "null"
      ]
    },
    "country": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{2}$"
    },
    "level": {
      "type": "integer",
      "minimum": 1
    },
    "trophies": {
      "type": "integer",
      "minimum": 0
    },
    "streak": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "null when the profile is not visible to the viewer."
    },
    "pro": {
      "type": "boolean",
      "description": "Has Pushly Pro — shows the PRO badge (D-073, migration 0029)."
    },
    "frame": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "gold",
        "neon",
        "fire",
        "ice",
        "royal",
        null
      ],
      "description": "Pro profile frame, only while the user is Pro (D-074, migration 0030)."
    }
  }
}
