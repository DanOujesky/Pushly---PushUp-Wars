{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pushly.app/contracts/season-history.schema.json",
  "title": "SeasonHistory",
  "description": "rpc get_season_history() \u2014 my archived seasons, newest first (doc 08 \u00a72.5, migration 0022). Example: fixtures/season_history.json.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "seasonId",
      "month",
      "finalTrophies",
      "bestTrophies",
      "league",
      "tier",
      "rank"
    ],
    "additionalProperties": false,
    "properties": {
      "seasonId": {
        "type": "integer"
      },
      "month": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}$"
      },
      "finalTrophies": {
        "type": "integer"
      },
      "bestTrophies": {
        "type": "integer"
      },
      "league": {
        "enum": [
          "bronze",
          "silver",
          "gold",
          "platinum",
          "diamond",
          "champion",
          "legend"
        ]
      },
      "tier": {
        "type": [
          "string",
          "null"
        ],
        "enum": [
          "I",
          "II",
          "III",
          null
        ]
      },
      "rank": {
        "type": "integer",
        "minimum": 1
      }
    }
  }
}
