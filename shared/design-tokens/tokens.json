{
  "$schemaVersion": 1,
  "color": {
    "bg.base":        { "dark": "#0B0B12", "light": "#F6F6FA" },
    "bg.surface":     { "dark": "#151522", "light": "#FFFFFF" },
    "bg.elevated":    { "dark": "#1F1F31", "light": "#FFFFFF" },
    "stroke.subtle":  { "dark": "#2A2A40", "light": "#E4E4EE" },
    "text.primary":   { "dark": "#F5F5FA", "light": "#12121C" },
    "text.secondary": { "dark": "#A3A3B8", "light": "#5B5B70" },
    "text.tertiary":  { "dark": "#6E6E85", "light": "#8C8CA0" },
    "brand.flame":    { "dark": "#FF5A1F", "light": "#F04E12" },
    "brand.volt":     { "dark": "#7B5CFF", "light": "#6A4BF0" },
    "brand.lime":     { "dark": "#C6FF3D", "light": "#679C00" },
    "brand.cyan":     { "dark": "#22D3EE", "light": "#0891B2" },
    "state.success":  { "dark": "#22C55E", "light": "#16A34A" },
    "state.warning":  { "dark": "#F59E0B", "light": "#D97706" },
    "state.danger":   { "dark": "#EF4444", "light": "#DC2626" },
    "league.bronze":   { "dark": "#C77B4A", "light": "#C77B4A" },
    "league.silver":   { "dark": "#C0C7D6", "light": "#C0C7D6" },
    "league.gold":     { "dark": "#F5C542", "light": "#F5C542" },
    "league.platinum": { "dark": "#4FD1C5", "light": "#4FD1C5" },
    "league.diamond":  { "dark": "#6EA8FF", "light": "#6EA8FF" },
    "league.champion": { "dark": "#FF6B9A", "light": "#FF6B9A" },
    "chart.series4":  { "dark": "#C6FF3D", "light": "#679C00" },
    "chart.series5":  { "dark": "#F472B6", "light": "#DB2777" }
  },
  "gradient": {
    "hero":    { "angle": 135, "stops": ["brand.flame", "brand.volt"] },
    "success": { "angle": 135, "stops": ["brand.lime", "brand.cyan"] },
    "legend":  { "angle": 135, "stops": ["brand.flame", "brand.volt"] }
  },
  "contrast": {
    "text": [
      ["text.primary", "bg.base"], ["text.primary", "bg.surface"], ["text.primary", "bg.elevated"],
      ["text.secondary", "bg.base"], ["text.secondary", "bg.surface"]
    ],
    "graphics": [
      ["brand.flame", "bg.surface"], ["brand.volt", "bg.surface"], ["brand.cyan", "bg.surface"],
      ["brand.lime", "bg.surface"], ["state.success", "bg.surface"], ["state.danger", "bg.surface"]
    ]
  },
  "spacing": { "xxs": 2, "xs": 4, "s": 8, "sm": 12, "m": 16, "ml": 20, "l": 24, "xl": 32, "xxl": 40, "xxxl": 56, "gutter": 16 },
  "radius":  { "s": 8, "m": 14, "l": 22, "pill": 999 },
  "typography": {
    "display.counter": { "textStyle": "largeTitle", "size": 120, "lineHeight": 120, "weight": "extraBold", "family": "display", "minSize": 88 },
    "display.xl":      { "textStyle": "largeTitle", "size": 48, "lineHeight": 52, "weight": "bold", "family": "display" },
    "display.l":       { "textStyle": "largeTitle", "size": 34, "lineHeight": 40, "weight": "bold", "family": "display" },
    "title.l":         { "textStyle": "title", "size": 28, "lineHeight": 34, "weight": "bold", "family": "system" },
    "title.m":         { "textStyle": "title2", "size": 22, "lineHeight": 28, "weight": "semibold", "family": "system" },
    "title.s":         { "textStyle": "headline", "size": 17, "lineHeight": 22, "weight": "semibold", "family": "system" },
    "body":            { "textStyle": "body", "size": 17, "lineHeight": 22, "weight": "regular", "family": "system" },
    "body.s":          { "textStyle": "subheadline", "size": 15, "lineHeight": 20, "weight": "regular", "family": "system" },
    "caption":         { "textStyle": "caption", "size": 12, "lineHeight": 16, "weight": "medium", "family": "system" },
    "overline":        { "textStyle": "caption2", "size": 11, "lineHeight": 14, "weight": "bold", "family": "system", "tracking": 0.08, "uppercase": true }
  },
  "fontFamily": { "display": "BarlowCondensed", "system": "system" },
  "motion": {
    "fast": { "ms": 120, "curve": "easeOut" },
    "base": { "ms": 240, "curve": "easeInOut" },
    "slow": { "ms": 600, "curve": "spring", "damping": 0.8 },
    "pop":  { "ms": 180, "curve": "springStiff" }
  },
  "touchTarget": { "iosPt": 44, "androidDp": 48 }
}
