<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Other permissions are added by the features that need them (camera: Phase 3, alarms: Phase 2) and are
         always requested in context with an explainer screen (CLAUDE.md §10). -->

    <application
        android:name=".PushlyApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Pushly">

        <!-- AdMob app id (D-073): Google's test id unless ADMOB_ANDROID_APP_ID is set (app/build.gradle.kts). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- pushly:// deep links (doc 15 §3) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pushly" />
            </intent-filter>

            <!-- https://pushly.app App Links (requires assetlinks.json on the domain — decisions log Q-01) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pushly.app" />
            </intent-filter>
        </activity>

        <!-- FCM (P6-06): token refresh + foreground messages. Firebase is initialised in code (PushRegistrar). -->
        <service
            android:name=".push.PushlyMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="pushly_activity" />
    </application>
</manifest>
