# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Secrets (never commit)
*.env
.env*
!.env.example
ios/Config/Secrets.xcconfig
android/local.properties
android/secrets.properties
supabase/.env
supabase/functions/.env

# iOS
ios/build/
ios/DerivedData/
ios/*.xcodeproj/xcuserdata/
ios/*.xcodeproj/project.xcworkspace/xcuserdata/
ios/**/.build/
ios/**/.swiftpm/
*.ipa
*.dSYM.zip

# Android
android/.gradle/
android/build/
android/**/build/
android/captures/
*.apk
*.aab
*.keystore
# shared debug key (not a secret, D-078): stable SHA-1 for Google sign-in on debug builds
!android/app/debug.keystore
*.jks

# Supabase
supabase/.branches/
supabase/.temp/

# Node / Deno / Python tooling
node_modules/
.deno/
__pycache__/
*.pyc
.pytest_cache/

# Pose recorder raw videos (only landmark JSON is committed, doc 05 §8)
tools/pose-recorder/raw/
*.mov
*.mp4

# Spikes are throwaway (doc 17)
spikes/**/build/

# XcodeGen output (regenerate with: cd ios && xcodegen generate)
ios/Pushly.xcodeproj/

# Kotlin compiler daemon data (Android Studio)
.kotlin/

# generated public site
/build/

# Firebase client config for push (CI writes it from the GOOGLE_SERVICES_JSON secret)
android/app/google-services.json
